# =============================================================
# EasyRead - configurazione LLM provider
# Copia questo file in .env e imposta le tue chiavi
# =============================================================

# --- Provider da usare: "openrouter" oppure "ollama" ---
LLM_PROVIDER=openrouter

# --- OpenRouter (consigliato: tier gratuito) ---
# Registrati su https://openrouter.ai e crea una API key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modello gratuito consigliato (buon italiano):
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Alternative gratuite:
#   qwen/qwen-2.5-72b-instruct:free
#   google/gemini-2.0-flash-exp:free
#   mistralai/mistral-small-3.2-24b-instruct:free

# --- Ollama (fallback locale, offline) ---
# Installa Ollama da https://ollama.com e poi: `ollama pull qwen2.5:7b`
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
