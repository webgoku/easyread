# Chiave API Anthropic. Creala su https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Modello usato dagli agenti.
# Haiku 4.5 e' il piu' economico e veloce: adatto a una pipeline di 4 chiamate.
ANTHROPIC_MODEL=claude-haiku-4-5

# Alternative, se serve piu' qualita' sulla semplificazione:
#   ANTHROPIC_MODEL=claude-sonnet-5
#   ANTHROPIC_MODEL=claude-opus-5
#
# Nota: gli ID dei modelli non vogliono il suffisso con la data.
# Usa "claude-haiku-4-5", non "claude-haiku-4-5-20251001".
