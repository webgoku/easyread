OPENROUTER_API_KEY=your_openrouter_api_key_here

# Modello gratuito, verificato funzionante il 14/09/2026.
# Classifica correttamente in italiano e rispetta lo schema JSON.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ATTENZIONE: OpenRouter ritira e sostituisce i modelli :free senza preavviso.
# Se ottieni "No endpoints found", il modello non esiste piu': scegline un altro
# dalla lista aggiornata su https://openrouter.ai/models?max_price=0
#
# Alternative gratuite (risultavano rate-limited al momento del test):
#   google/gemma-4-31b-it:free
#   google/gemma-4-26b-a4b-it:free
#
# A pagamento, se serve piu' qualita' o velocita':
